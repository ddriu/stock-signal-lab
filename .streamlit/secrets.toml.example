# Copia este contenido en Settings > Secrets de Streamlit Community Cloud.
# Genera tu propio hash con:
# python -c "from src.auth import hash_password; print(hash_password('TU_CONTRASEÑA'))"

[app_auth]
username = "CAMBIA_EL_USUARIO"
password_hash = "PEGA_AQUI_EL_HASH"

[deployment]
# Community Cloud no garantiza que un archivo SQLite sobreviva a reinicios.
persistent_journal = false
