# Copia este contenido en Settings > Secrets de Streamlit Community Cloud.
# Genera un hash distinto para cada contraseña con:
# python -c "from src.auth import hash_password; print(hash_password('TU_CONTRASEÑA'))"

[users.alberite]
display_name = "Alberite"
role = "admin"
password_hash = "PEGA_AQUI_EL_HASH_DEL_ADMIN"

[users.usuario1]
display_name = "Usuario 1"
role = "user"
password_hash = "PEGA_AQUI_UN_HASH_DISTINTO"

[users.usuario2]
display_name = "Usuario 2"
role = "user"
password_hash = "PEGA_AQUI_UN_HASH_DISTINTO"

[users.usuario3]
display_name = "Usuario 3"
role = "user"
password_hash = "PEGA_AQUI_UN_HASH_DISTINTO"

[users.usuario4]
display_name = "Usuario 4"
role = "user"
password_hash = "PEGA_AQUI_UN_HASH_DISTINTO"

[deployment]
# Sólo se usa cuando no hay Supabase. Community Cloud no conserva SQLite.
persistent_journal = false

[supabase]
# Project Settings > API / Connect. Usa una clave sb_secret_* sólo en el servidor.
url = "https://TU_PROYECTO.supabase.co"
secret_key = "sb_secret_CAMBIA_ESTA_CLAVE"
table = "operations"
