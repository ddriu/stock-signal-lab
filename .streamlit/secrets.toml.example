# Copia este contenido en Settings > Secrets de Streamlit Community Cloud.
# Genera un hash distinto para cada contraseña con:
# python -c "from src.auth import hash_password; print(hash_password('TU_CONTRASEÑA'))"

[users.alberite]
display_name = "Alberite"
role = "admin"
password_hash = "PEGA_AQUI_EL_HASH_DEL_ADMIN"

[users.luci]
display_name = "Luci"
role = "user"
password_hash = "PEGA_AQUI_UN_HASH_DISTINTO"

[users.fer]
display_name = "Fer"
role = "user"
password_hash = "PEGA_AQUI_UN_HASH_DISTINTO"

[users.xavi]
display_name = "Xavi"
role = "user"
password_hash = "PEGA_AQUI_UN_HASH_DISTINTO"

[users.ddriu]
display_name = "ddriu"
role = "user"
password_hash = "PEGA_AQUI_UN_HASH_DISTINTO"

[deployment]
# Sólo se usa cuando no hay Supabase. Community Cloud no conserva SQLite.
persistent_journal = false

[supabase]
# Project Settings > API / Connect. Usa una clave sb_secret_* sólo en el servidor.
url = "https://TU_PROYECTO.supabase.co"
secret_key = "sb_secret_CAMBIA_ESTA_CLAVE"
table = "operations"
favorites_table = "favorites"
analysis_table = "analysis_snapshots"
# Opcional: private_investments_table = "private_investments"
# Opcional: portfolio_accounts_table = "portfolio_accounts"

[email]
# Cuenta Gmail exclusiva del proyecto. Usa una contraseña de aplicación,
# nunca la contraseña normal de Google.
smtp_host = "smtp.gmail.com"
smtp_port = 465
use_ssl = true
username = "stocksignallab.alertas@gmail.com"
app_password = "PEGA_AQUI_LA_CONTRASEÑA_DE_APLICACION"
sender_email = "stocksignallab.alertas@gmail.com"
sender_name = "Stock Signal Lab"
